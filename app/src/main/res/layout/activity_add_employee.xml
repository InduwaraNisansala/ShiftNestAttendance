<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="@drawable/shiftnest_background" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">
  <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/shiftnest_card" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:elevation="4dp">
      <androidx.appcompat.widget.AppCompatButton android:textSize="14sp" android:textStyle="bold" android:id="@+id/btnTopBack" android:padding="8dp" android:layout_width="0dp" android:layout_height="wrap_content" android:text="← BACK" android:layout_weight="1.000000" android:textColor="@color/shiftnest_secondary" android:background="@drawable/shiftnest_secondary" android:backgroundTint="@null" android:minHeight="56dp" android:textAllCaps="false"/>
      <TextView android:textSize="17sp" android:textStyle="bold" android:textColor="@color/shiftnest_heading" android:gravity="center" android:id="@+id/tvTopTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:text="ShiftNest Attendance" android:layout_weight="2.000000"/>
      <androidx.appcompat.widget.AppCompatButton android:textSize="14sp" android:textStyle="bold" android:id="@+id/btnTopHome" android:padding="8dp" android:layout_width="0dp" android:layout_height="wrap_content" android:text="⌂ HOME" android:layout_weight="1.000000" android:textColor="@color/shiftnest_secondary" android:background="@drawable/shiftnest_secondary" android:backgroundTint="@null" android:minHeight="56dp" android:textAllCaps="false" android:visibility="gone"/>
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
      <TextView android:textSize="28sp" android:textStyle="bold" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="25dp" android:text="Add Employee" android:textColor="@color/shiftnest_heading"/>
      <EditText android:id="@+id/etEmployeeName" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:hint="Employee Name" android:inputType="textPersonName" android:textColor="@color/shiftnest_text" android:background="@drawable/shiftnest_input" android:backgroundTint="@null" android:textColorHint="@color/shiftnest_hint" android:minHeight="56dp" android:focusable="true" android:focusableInTouchMode="true" android:cursorVisible="true"/>
      <EditText android:id="@+id/etEmployeePhone" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" android:hint="Phone Number" android:inputType="phone" android:textColor="@color/shiftnest_text" android:background="@drawable/shiftnest_input" android:backgroundTint="@null" android:textColorHint="@color/shiftnest_hint" android:minHeight="56dp" android:focusable="true" android:focusableInTouchMode="true" android:cursorVisible="true"/>
      <TextView android:textSize="16sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Employee Role" android:textColor="@color/shiftnest_heading"/>
      <com.shiftnest.attendance.ShiftNestChoiceSpinner android:spinnerMode="dropdown" android:dropDownWidth="match_parent" android:popupBackground="@color/shiftnest_surface" android:background="@drawable/shiftnest_input" android:backgroundTint="@null" android:id="@+id/spinnerRole" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" android:minHeight="56dp"/>
      <TextView android:textSize="16sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Work Location Type" android:textColor="@color/shiftnest_heading"/>
      <RadioGroup android:orientation="vertical" android:id="@+id/radioGroupLocationType" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp">
        <RadioButton android:textSize="16sp" android:id="@+id/radioFixedLocation" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fixed Location" android:textColor="@color/shiftnest_text"/>
        <RadioButton android:textSize="16sp" android:id="@+id/radioNoFixedLocation" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No Fixed Location" android:textColor="@color/shiftnest_text"/>
      </RadioGroup>
      <TextView android:textSize="15sp" android:id="@+id/tvLocationInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Select a work location" android:textColor="@color/shiftnest_text"/>
      <com.shiftnest.attendance.ShiftNestChoiceSpinner android:spinnerMode="dropdown" android:dropDownWidth="match_parent" android:popupBackground="@color/shiftnest_surface" android:background="@drawable/shiftnest_input" android:backgroundTint="@null" android:id="@+id/spinnerLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="25dp" android:minHeight="56dp"/>
      <androidx.appcompat.widget.AppCompatButton android:textSize="17sp" android:textStyle="bold" android:id="@+id/btnSaveEmployee" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SAVE EMPLOYEE" android:textColor="@color/shiftnest_on_primary" android:background="@drawable/shiftnest_primary" android:backgroundTint="@null" android:minHeight="56dp" android:textAllCaps="false"/>
    </LinearLayout>
  </LinearLayout>
</ScrollView>

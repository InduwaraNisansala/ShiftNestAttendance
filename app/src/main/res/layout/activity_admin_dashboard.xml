<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/shiftnest_background" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">
  <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/shiftnest_card" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:elevation="4dp">
    <androidx.appcompat.widget.AppCompatButton android:textSize="14sp" android:textStyle="bold" android:id="@+id/btnTopBack" android:padding="8dp" android:layout_width="0dp" android:layout_height="wrap_content" android:text="← BACK" android:layout_weight="1.000000" android:textColor="@color/shiftnest_secondary" android:background="@drawable/shiftnest_secondary" android:backgroundTint="@null" android:minHeight="56dp" android:textAllCaps="false"/>
    <TextView android:textSize="17sp" android:textStyle="bold" android:textColor="@color/shiftnest_heading" android:gravity="center" android:id="@+id/tvTopTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:text="ShiftNest Attendance" android:layout_weight="2.000000"/>
    <androidx.appcompat.widget.AppCompatButton android:textSize="14sp" android:textStyle="bold" android:id="@+id/btnTopHome" android:padding="8dp" android:layout_width="0dp" android:layout_height="wrap_content" android:text="⌂ HOME" android:layout_weight="1.000000" android:textColor="@color/shiftnest_secondary" android:background="@drawable/shiftnest_secondary" android:backgroundTint="@null" android:minHeight="56dp" android:textAllCaps="false" android:visibility="gone"/>
  </LinearLayout>
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
      <TextView android:textSize="28sp" android:textStyle="bold" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="30dp" android:text="Admin Dashboard" android:textColor="@color/shiftnest_heading"/>
      <androidx.appcompat.widget.AppCompatButton android:textSize="17sp" android:textStyle="bold" android:id="@+id/btnAddEmployee" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ADD EMPLOYEE" android:textColor="@color/shiftnest_on_primary" android:background="@drawable/shiftnest_primary" android:backgroundTint="@null" android:minHeight="56dp" android:textAllCaps="false"/>
      <androidx.appcompat.widget.AppCompatButton android:textSize="17sp" android:textStyle="bold" android:id="@+id/btnAddLocation" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="ADD LOCATION" android:textColor="@color/shiftnest_on_primary" android:background="@drawable/shiftnest_primary" android:backgroundTint="@null" android:minHeight="56dp" android:textAllCaps="false"/>
      <androidx.appcompat.widget.AppCompatButton android:textSize="17sp" android:textStyle="bold" android:id="@+id/btnEmployeeList" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="EMPLOYEE LIST" android:textColor="@color/shiftnest_on_primary" android:background="@drawable/shiftnest_primary" android:backgroundTint="@null" android:minHeight="56dp" android:textAllCaps="false"/>
      <androidx.appcompat.widget.AppCompatButton android:textSize="17sp" android:textStyle="bold" android:id="@+id/btnAttendanceReport" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="ATTENDANCE REPORT" android:textColor="@color/shiftnest_on_primary" android:background="@drawable/shiftnest_primary" android:backgroundTint="@null" android:minHeight="56dp" android:textAllCaps="false"/>
      <androidx.appcompat.widget.AppCompatButton android:textSize="16sp" android:textStyle="bold" android:id="@+id/btnLocationTracking" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="LOCATION TRACKING" android:textColor="@color/shiftnest_on_primary" android:background="@drawable/shiftnest_primary" android:backgroundTint="@null" android:minHeight="56dp" android:textAllCaps="false"/>
    </LinearLayout>
  </ScrollView>
</LinearLayout>

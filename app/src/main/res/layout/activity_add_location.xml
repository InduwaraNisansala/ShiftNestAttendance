<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/shiftnest_background" android:fitsSystemWindows="true">
  <LinearLayout android:orientation="vertical" android:background="@android:color/transparent" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:fitsSystemWindows="true">
    <TextView android:textSize="28sp" android:textStyle="bold" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="25dp" android:text="Add Location" android:textColor="@color/shiftnest_heading"/>
    <EditText android:id="@+id/etLocationName" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:hint="Location Name" android:inputType="text" android:textColor="@color/shiftnest_text" android:background="@drawable/shiftnest_input" android:backgroundTint="@null" android:textColorHint="@color/shiftnest_hint" android:minHeight="56dp" android:focusable="true" android:focusableInTouchMode="true" android:cursorVisible="true"/>
    <androidx.appcompat.widget.AppCompatButton android:textSize="16sp" android:textStyle="bold" android:id="@+id/btnSelectLocation" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GET CURRENT LOCATION" android:textColor="@color/shiftnest_on_primary" android:background="@drawable/shiftnest_primary" android:backgroundTint="@null" android:minHeight="56dp" android:textAllCaps="false"/>
    <TextView android:textSize="16sp" android:id="@+id/tvLatitude" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Latitude: --" android:textColor="@color/shiftnest_text"/>
    <TextView android:textSize="16sp" android:id="@+id/tvLongitude" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Longitude: --" android:textColor="@color/shiftnest_text"/>
    <EditText android:id="@+id/etRadius" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="Allowed Radius (meters)" android:inputType="number" android:textColor="@color/shiftnest_text" android:background="@drawable/shiftnest_input" android:backgroundTint="@null" android:textColorHint="@color/shiftnest_hint" android:minHeight="56dp" android:focusable="true" android:focusableInTouchMode="true" android:cursorVisible="true"/>
    <androidx.appcompat.widget.AppCompatButton android:textSize="17sp" android:textStyle="bold" android:id="@+id/btnSaveLocation" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="25dp" android:text="SAVE LOCATION" android:textColor="@color/shiftnest_on_primary" android:background="@drawable/shiftnest_primary" android:backgroundTint="@null" android:minHeight="56dp" android:textAllCaps="false"/>
  </LinearLayout>
</ScrollView>

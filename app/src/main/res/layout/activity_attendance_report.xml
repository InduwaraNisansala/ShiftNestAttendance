<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="@drawable/shiftnest_background" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:fitsSystemWindows="true">
  <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:textSize="28sp" android:textStyle="bold" android:textColor="@color/shiftnest_heading" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:text="SHIFTNEST ATTENDANCE"/>
    <TextView android:textSize="16sp" android:textColor="@color/shiftnest_text" android:gravity="center" android:id="@+id/tvReportDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:text="Daily Attendance Report"/>
    <androidx.appcompat.widget.AppCompatButton android:textSize="16sp" android:textStyle="bold" android:id="@+id/btnDownloadPdf" android:padding="14dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="DOWNLOAD PDF" android:textColor="@color/shiftnest_on_primary" android:background="@drawable/shiftnest_primary" android:backgroundTint="@null" android:minHeight="56dp" android:textAllCaps="false"/>
    <androidx.appcompat.widget.AppCompatButton android:textSize="16sp" android:textStyle="bold" android:id="@+id/btnSharePdf" android:padding="14dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:text="SHARE PDF" android:textColor="@color/shiftnest_secondary" android:background="@drawable/shiftnest_secondary" android:backgroundTint="@null" android:minHeight="56dp" android:textAllCaps="false"/>
    <LinearLayout android:orientation="vertical" android:background="@drawable/shiftnest_card" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:elevation="3dp">
      <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/shiftnest_heading" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="COMPANY OVERALL"/>
      <TextView android:textSize="15sp" android:textColor="@color/shiftnest_text" android:id="@+id/tvOverallSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Overall Total: 0"/>
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:background="@drawable/shiftnest_card" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:elevation="3dp">
      <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/shiftnest_heading" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OVERALL ATTENDANCE"/>
      <TextView android:textSize="14sp" android:textStyle="bold" android:id="@+id/tvBarCheckIn" android:paddingTop="5dp" android:paddingBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Check In - 0" android:textColor="@color/shiftnest_heading"/>
      <ProgressBar android:id="@+id/pbCheckIn" android:layout_width="match_parent" android:layout_height="18dp" android:layout_marginBottom="10dp" android:max="100" android:progress="0" style="?android:attr/progressBarStyleHorizontal"/>
      <TextView android:textSize="14sp" android:textStyle="bold" android:id="@+id/tvBarLate" android:paddingTop="5dp" android:paddingBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Late - 0" android:textColor="@color/shiftnest_heading"/>
      <ProgressBar android:id="@+id/pbLate" android:layout_width="match_parent" android:layout_height="18dp" android:layout_marginBottom="10dp" android:max="100" android:progress="0" style="?android:attr/progressBarStyleHorizontal"/>
      <TextView android:textSize="14sp" android:textStyle="bold" android:id="@+id/tvBarAbsent" android:paddingTop="5dp" android:paddingBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Absent - 0" android:textColor="@color/shiftnest_heading"/>
      <ProgressBar android:id="@+id/pbAbsent" android:layout_width="match_parent" android:layout_height="18dp" android:layout_marginBottom="10dp" android:max="100" android:progress="0" style="?android:attr/progressBarStyleHorizontal"/>
      <TextView android:textSize="14sp" android:textStyle="bold" android:id="@+id/tvBarCheckout" android:paddingTop="5dp" android:paddingBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Checked Out - 0" android:textColor="@color/shiftnest_heading"/>
      <ProgressBar android:id="@+id/pbCheckout" android:layout_width="match_parent" android:layout_height="18dp" android:layout_marginBottom="5dp" android:max="100" android:progress="0" style="?android:attr/progressBarStyleHorizontal"/>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:weightSum="4.000000">
      <TextView android:textSize="13sp" android:textStyle="bold" android:gravity="center" android:id="@+id/tvOnTimeCount" android:background="@drawable/shiftnest_card" android:layout_width="0dp" android:layout_height="90dp" android:layout_margin="3dp" android:text="ON TIME&#10;0" android:layout_weight="1.000000" android:elevation="3dp" android:textColor="@color/shiftnest_heading"/>
      <TextView android:textSize="13sp" android:textStyle="bold" android:gravity="center" android:id="@+id/tvLateCount" android:background="@drawable/shiftnest_card" android:layout_width="0dp" android:layout_height="90dp" android:layout_margin="3dp" android:text="LATE&#10;0" android:layout_weight="1.000000" android:elevation="3dp" android:textColor="@color/shiftnest_heading"/>
      <TextView android:textSize="13sp" android:textStyle="bold" android:gravity="center" android:id="@+id/tvAbsentCount" android:background="@drawable/shiftnest_card" android:layout_width="0dp" android:layout_height="90dp" android:layout_margin="3dp" android:text="ABSENT&#10;0" android:layout_weight="1.000000" android:elevation="3dp" android:textColor="@color/shiftnest_heading"/>
      <TextView android:textSize="13sp" android:textStyle="bold" android:gravity="center" android:id="@+id/tvCheckoutCount" android:background="@drawable/shiftnest_card" android:layout_width="0dp" android:layout_height="90dp" android:layout_margin="3dp" android:text="CHECKED OUT&#10;0" android:layout_weight="1.000000" android:elevation="3dp" android:textColor="@color/shiftnest_heading"/>
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:id="@+id/employeeChartContainer" android:background="@drawable/shiftnest_card" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:elevation="3dp"/>
    <LinearLayout android:orientation="vertical" android:id="@+id/departmentSummaryContainer" android:background="@drawable/shiftnest_card" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:elevation="3dp"/>
    <LinearLayout android:orientation="vertical" android:id="@+id/roleContainer" android:background="@drawable/shiftnest_card" android:padding="5dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:elevation="3dp"/>
    <TextView android:textSize="15sp" android:gravity="center" android:id="@+id/tvLoading" android:padding="15dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Loading..." android:textColor="@color/shiftnest_text"/>
  </LinearLayout>
</ScrollView>

<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/shiftnest_background" android:fillViewport="true" android:fitsSystemWindows="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="24dp">
  <ImageView android:layout_width="match_parent" android:layout_height="150dp" android:src="@drawable/shiftnest_logo" android:contentDescription="ShiftNest" android:layout_marginTop="24dp" android:scaleType="fitCenter" android:layout_marginBottom="24dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/shiftnest_card" android:padding="22dp">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Employee Login" android:textSize="27sp" android:textStyle="bold" android:textColor="@color/shiftnest_heading" android:gravity="center" android:layout_marginTop="8dp" android:layout_marginBottom="30dp"/>
   <EditText android:id="@+id/etPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:background="@drawable/shiftnest_input" android:backgroundTint="@null" android:padding="16dp" android:textColor="@color/shiftnest_text" android:textColorHint="@color/shiftnest_hint" android:hint="Phone Number" android:inputType="phone" android:autofillHints="phone" android:singleLine="true" android:textSize="17sp" android:layout_marginBottom="22dp" android:drawableStart="@drawable/shiftnest_ic_phone" android:drawablePadding="12dp" android:drawableTint="@color/shiftnest_secondary" android:focusable="true" android:focusableInTouchMode="true" android:cursorVisible="true"/>
   <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnSendOtp" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:padding="16dp" android:background="@drawable/shiftnest_primary" android:backgroundTint="@null" android:text="SEND OTP" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/shiftnest_on_primary" android:drawableStart="@drawable/shiftnest_ic_send" android:drawablePadding="12dp" android:drawableTint="@color/shiftnest_on_primary"/>

  </LinearLayout>
   <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnAdminLogin" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:padding="16dp" android:layout_marginTop="28dp" android:layout_marginBottom="8dp" android:background="@drawable/shiftnest_secondary" android:backgroundTint="@null" android:text="ADMIN LOGIN" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/shiftnest_secondary" android:drawableStart="@drawable/shiftnest_ic_shield" android:drawablePadding="12dp" android:drawableTint="@color/shiftnest_secondary"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="BUILDING A BETTER TOMORROW" android:textSize="10sp" android:letterSpacing="0.15" android:textColor="@color/shiftnest_secondary" android:layout_marginTop="32dp" android:layout_marginBottom="24dp"/>
 </LinearLayout>
</ScrollView>

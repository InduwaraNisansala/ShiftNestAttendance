<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="@drawable/shiftnest_background" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">
  <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/tvDashboardTitle" android:textSize="26sp" android:textStyle="bold" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="25dp" android:text="Employee Dashboard" android:textColor="@color/shiftnest_heading"/>
    <TextView android:textSize="20sp" android:textStyle="bold" android:id="@+id/tvEmployeeName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Welcome, Employee" android:textColor="@color/shiftnest_heading"/>
    <TextView android:textSize="17sp" android:id="@+id/tvEmployeeRole" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="25dp" android:text="Role: Sales Officer" android:textColor="@color/shiftnest_text"/>
    <TextView android:textSize="20sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="15dp" android:text="Today's Attendance" android:textColor="@color/shiftnest_heading"/>
    <androidx.appcompat.widget.AppCompatButton android:textSize="17sp" android:textStyle="bold" android:id="@+id/btnCheckIn" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CHECK IN" android:textColor="@color/shiftnest_on_primary" android:background="@drawable/shiftnest_primary" android:backgroundTint="@null" android:minHeight="56dp" android:textAllCaps="false"/>
    <androidx.appcompat.widget.AppCompatButton android:textSize="17sp" android:textStyle="bold" android:id="@+id/btnCheckOut" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="CHECK OUT" android:textColor="@color/shiftnest_secondary" android:background="@drawable/shiftnest_secondary" android:backgroundTint="@null" android:minHeight="56dp" android:textAllCaps="false"/>
    <TextView android:textSize="17sp" android:id="@+id/tvCheckIn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="25dp" android:text="Check In: --:--" android:textColor="@color/shiftnest_text"/>
    <TextView android:textSize="17sp" android:id="@+id/tvCheckOut" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Check Out: --:--" android:textColor="@color/shiftnest_text"/>
    <androidx.appcompat.widget.AppCompatButton android:textSize="16sp" android:id="@+id/btnAttendanceHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="25dp" android:text="ATTENDANCE HISTORY" android:textColor="@color/shiftnest_secondary" android:background="@drawable/shiftnest_secondary" android:backgroundTint="@null" android:minHeight="56dp" android:textAllCaps="false"/>
    <androidx.appcompat.widget.AppCompatButton android:textSize="16sp" android:textStyle="bold" android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="LOGOUT" android:textColor="@color/shiftnest_secondary" android:background="@drawable/shiftnest_secondary" android:backgroundTint="@null" android:minHeight="56dp" android:textAllCaps="false"/>
  </LinearLayout>
</ScrollView>
